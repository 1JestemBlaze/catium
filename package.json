{
  "name": "catium",
  "version": "0.3.1",
  "description": "Catium - Minecraft launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.4",
    "electron-updater": "^6.3.9",
    "@xhayper/discord-rpc": "^1.2.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "pl.catium.launcher",
    "productName": "Catium",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "1JestemBlaze",
        "repo": "catium",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Catium-Setup-${version}.${ext}"
    }
  },
  "author": "1JestemBlaze"
}
