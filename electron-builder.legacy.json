{
  "appId": "pl.catium.launcher",
  "productName": "Catium",
  "electronVersion": "22.3.27",
  "directories": {
    "buildResources": "build",
    "output": "dist-win7"
  },
  "files": [
    "main.js",
    "preload.js",
    "renderer/**",
    "package.json"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "1JestemBlaze",
      "repo": "catium",
      "releaseType": "release",
      "channel": "win7"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "Catium-Win7-Setup-${version}.${ext}"
  }
}